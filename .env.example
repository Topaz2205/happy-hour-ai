# Happy Hour Cocktails AI — environment example (safe placeholders only)
#
# Local:      cp .env.example backend/.env   (./setup.sh does this for you)
# Production: set these in the Render (API) and Vercel (frontend) dashboards.
# Never commit real values. backend/.env is git-ignored.

# ── Backend (FastAPI) ────────────────────────────────────────────────────

# "production" turns missing security settings into a startup error and hides
# internal error details from API responses.
ENVIRONMENT=development

# PostgreSQL. docker-compose overrides this for the local stack.
DATABASE_URL=postgresql+asyncpg://happyhour:happyhour@localhost:5432/happyhour

# Signs sign-in tokens. REQUIRED in production, ≥ 32 random characters, the
# same on every API instance. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=

# Sign-in token lifetime in hours (default 7 days).
AUTH_TOKEN_TTL_HOURS=168

# Set to false to close new sign-ups.
ALLOW_SIGNUP=true
SIGNUP_DAILY_LIMIT_PER_IP=20
LOGIN_FAILURES_PER_HOUR=10

# Paid-AI protection, enforced in the database per UTC day.
# Per user, and across everyone (0 disables the global ceiling).
AI_DAILY_REQUEST_LIMIT=10
AI_GLOBAL_DAILY_REQUEST_LIMIT=300

# AI provider: groq | anthropic | gemini | openrouter
# (The pre-event coach needs an OpenAI-compatible provider: groq, gemini or openrouter.)
LLM_PROVIDER=groq
LLM_API_KEY=
# Optional. Blank uses the provider default.
LLM_MODEL=
# Optional custom OpenAI-compatible endpoint.
LLM_BASE_URL=

# Frontend origins allowed to call the API, as a JSON list.
CORS_ORIGINS=["http://localhost:3000"]

# Local throw-away databases only: create tables without Alembic.
AUTO_CREATE_TABLES=false

# ── Frontend (Next.js, set in Vercel) ────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
