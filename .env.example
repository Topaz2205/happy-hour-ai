# Happy Hour AI — public environment example
#
# Copy the relevant values into backend/.env.
# Never commit real API keys.

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://happyhour:happyhour@localhost:5432/happyhour

# AI provider used by the guided event builder.
# Supported: groq | anthropic | gemini | openrouter
LLM_PROVIDER=groq

# Add your own provider key locally.
LLM_API_KEY=

# Optional. Leave blank to use the provider default.
LLM_MODEL=

# Optional custom OpenAI-compatible endpoint.
LLM_BASE_URL=

# Allowed frontend origins for the backend.
# Local defaults are already built into the application.

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
